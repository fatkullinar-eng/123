{
  "name": "bar-estimate",
  "version": "1.0.0",
  "private": true,
  "description": "Локальный калькулятор стоимости франшизы пивного бара",
  "author": "Bar Estimate",
  "license": "UNLICENSED",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node tests/browser.mjs",
    "format": "prettier --write src tests electron scripts *.json *.md index.html vite.config.ts",
    "format:check": "prettier --check src tests electron scripts *.json *.md index.html vite.config.ts",
    "desktop": "npm run build && electron .",
    "package:win": "npm run build && electron-builder --win dir --x64 && node scripts/compile-installer.cjs",
    "package:linux": "npm run build && electron-builder --linux dir --x64",
    "test:a11y": "node tests/accessibility.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^24.0.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "decimal.js": "10.6.0",
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "exceljs": "4.4.0",
    "lucide-react": "0.468.0",
    "papaparse": "5.5.3",
    "playwright-core": "^1.56.0",
    "prettier": "^3.6.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "build": {
    "appId": "local.bar.estimate",
    "productName": "Bar Estimate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "dir",
      "signAndEditExecutable": false,
      "artifactName": "Bar-Estimate-${version}-Setup.${ext}"
    },
    "afterPack": "scripts/after-pack.cjs"
  }
}
